# Copy next to docker-compose.yml as `.env` (install.ps1 writes it for you). All values are examples.
GM_CONTAINER=gilmok
GM_PORT=8088
GM_NETWORK=reverseproxy
GM_CADDY_DIR=../caddy
GM_AUTHELIA_DIR=../authelia
GM_AUTHELIA_CONFIG_DIR=../authelia/config
GM_CADDY_CONTAINER=caddy
GM_AUTHELIA_CONTAINER=authelia
GM_CROWDSEC_CONTAINER=crowdsec
TZ=Asia/Seoul
# first-start defaults (optional)
GM_DOMAIN=example.com
GM_TAILSCALE_IP=100.64.0.10
