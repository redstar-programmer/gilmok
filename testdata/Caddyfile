{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP
	}
}

# Cloudflare 인증된 원본 풀(mTLS): 내 Cloudflare 존을 거친 요청만 허용
# 주황 구름(프록시) 사이트에만 import. 회색 구름 사이트에 넣으면 접속 불가.
(cf_only) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/cf-origin-pull-ca.pem
		}
	}
}

(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

# =====================================================================
# 공개 서비스 (:443 — 공유기 포트포워딩으로 인터넷에 노출)
# =====================================================================

# --- 주황 구름 (Cloudflare 프록시 + mTLS) ---
auth.example.com {
	import cf_only
	reverse_proxy authelia:9091
}

joplin.example.com {
	import cf_only
	reverse_proxy app:22300
}

traccar.example.com {
	import cf_only
	reverse_proxy traccar:8082
}

# --- 회색 구름 (공유기 GeoIP로 보호) ---
immich.example.com {
	reverse_proxy immich_server:2283
}

plex.example.com {
	reverse_proxy host.docker.internal:32400
}

blog.example.com {
	reverse_proxy blog:3000
}

# =====================================================================
# Tailscale 전용 서비스 (:8443 — 127.0.0.1에만 열림)
# 집 PC의 `tailscale serve`가 Tailscale IP:443 → 127.0.0.1:8443 으로 전달.
# 인터넷(공인 IP:443)으로 이 도메인을 요청하면 일치하는 사이트가 없어 TLS 단계에서 끊김.
# =====================================================================

# --- Authelia 추가 보호 ---
list.example.com:8443 {
	import authelia
	reverse_proxy servicelist:80
}

downloader.example.com:8443 {
	import authelia
	reverse_proxy downloader:5175
}

